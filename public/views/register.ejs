<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Where2·Create account</title>
    <style>
      :root {
        --bg: #f4f7fb;
        --panel: #ffffff;
        --accent: #1d4ed8;
        --accent-dark: #153993;
        --text: #1f2937;
        --muted: #6b7280;
        --error: #b91c1c;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #eef6ff, #f8fafc);
        font-family: Arial, sans-serif;
        color: var(--text);
      }
      .auth-card {
        width: min(92vw, 480px);
        background: var(--panel);
        padding: 2rem;
        border-radius: 18px;
        box-shadow: 0 18px 40px rgba(30, 64, 175, 0.08);
      }
      h1 {
        margin-top: 0;
        margin-bottom: 0.5rem;
      }
      .subtitle {
        margin-top: 0;
        color: var(--muted);
      }
      form {
        display: grid;
        gap: 0.85rem;
        margin-top: 1.5rem;
      }
      label {
        display: grid;
        gap: 0.35rem;
        font-weight: 600;
      }
      input {
        width: 100%;
        padding: 0.8rem 0.9rem;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        font: inherit;
      }
      button {
        background: var(--accent);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 0.85rem 1rem;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
      }
      button:hover { background: var(--accent-dark); }
      .alt-link {
        display: block;
        margin-top: 1rem;
        text-align: center;
        color: var(--accent);
        text-decoration: none;
        font-weight: 600;
      }
      .notice {
        color: var(--error);
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        border: 1px solid #fecaca;
        border-radius: 10px;
        background: #fef2f2;
      }
    </style>
  </head>
  <body>
    <main class="auth-card">
      <h1>Where2</h1>
      <p class="subtitle">Create your account to explore campus resources.</p>

      <form method="post" action="/auth/register">
        <label>
          Name
          <input type="text" name="name" required placeholder="Your name">
        </label>
        <label>
          Email
          <input type="email" name="email" required placeholder="you@campus.edu">
        </label>
        <label>
          Password
          <input type="password" name="password" required placeholder="At least 6 characters">
        </label>
        <button type="submit">Create account</button>
      </form>

      <a class="alt-link" href="/login">Already have an account? Log in</a>

      <% if (message) { %>
        <p class="notice" role="alert"><%= message %></p>
      <% } %>
    </main>
  </body>
</html>
