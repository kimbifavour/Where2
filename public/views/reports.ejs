<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Where 2</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/resources.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <strong>Where 2</strong>
    <button
      id="navToggle"
      class="nav-toggle"
      type="button"
      aria-controls="site-nav"
      aria-expanded="false"
    >
      Menu
    </button>
  </header>
  <div class="app">
    <%- include('site-nav', { currentPage: 'reports' }) %>
    <main id="main" class="main" tabindex="-1">
      <div class="page-head">
        <h1>Confirm or dispute observations</h1>
        <p>Use one active vote per report. You may change it at any time, but you cannot vote on your own report.</p>
      </div>

      <div id="message" class="message" role="status" aria-live="polite"></div>
      <div id="report-list" class="report-list" aria-live="polite"></div>
    </main>
  </div>
  <script src="/js/reports.js" type="module"></script>
  <script src="/js/site-nav.js" defer></script>
</body>
</html>
